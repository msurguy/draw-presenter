{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": false,
    "noEmit": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "brushmark": ["./src/index.ts"],
      "brushmark/react": ["./src/react/index.ts"],
      "brushmark/gsap": ["./src/animation/gsap.ts"],
      "brushmark/anime": ["./src/animation/anime.ts"]
    }
  },
  "include": ["src", "demo"]
}
