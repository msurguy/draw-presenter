{
  "name": "draw-presenter",
  "version": "0.1.0",
  "description": "Presentation software where slides are drawn one stroke at a time: single-line Hershey fonts, hand-painted brush strokes, WGSL shader transitions, and a visual editor that writes plain React files.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/msurguy/draw-presenter.git"
  },
  "keywords": [
    "presentation",
    "slides",
    "hershey",
    "single-line-font",
    "plotter",
    "webgpu",
    "wgsl",
    "gsap",
    "react",
    "vite"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:shaders": "node scripts/check-shaders.mjs",
    "art": "node scripts/generate-art.mjs"
  },
  "dependencies": {
    "@vgpu/wgsl": "^0.3.1",
    "@vgpu/wgsl-std": "^0.3.1",
    "brushmark": "file:vendor/brushmark",
    "gsap": "^3.15.0",
    "mermaid": "^11.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svgpath": "^2.6.0",
    "three": "^0.180.0",
    "vgpu": "^0.3.1"
  },
  "allowScripts": {
    "@vgpu/adapter-node@0.3.1": true,
    "webgpu@0.4.0": true
  },
  "devDependencies": {
    "@babel/parser": "^7.29.8",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3-delaunay": "^6.0.4",
    "magic-string": "^0.30.21",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
